---
import '../styles/base.css';
import type { Locale, SiteConfig, NavItem, LayoutStrings } from '../lib/types';
import { localePath } from '../lib/i18n';

interface Props {
  site: SiteConfig;
  locale: Locale;
  /** Unlocalized path of this page, e.g. '/heroes/infernus' */
  path: string;
  title: string;
  description: string;
  nav: NavItem[];
  strings: LayoutStrings;
  jsonLd?: object | object[];
  ogImage?: string;
  /** Set false for pages that only exist in the default locale */
  localized?: boolean;
}
const { site, locale, path, title, description, nav, strings, jsonLd, ogImage, localized = true } = Astro.props;
const abs = (p: string) => site.url + p;
const canonical = abs(localePath(locale, path));
const alternates = localized ? site.locales.map((l) => ({ lang: l.lang, href: abs(localePath(l, path)) })) : [];
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={locale.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  {localized && <link rel="alternate" hreflang="x-default" href={abs(localePath(site.locales[0], path))} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0d0f13" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={locale.lang.replace('-', '_')} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <style set:html={`:root{--site-accent:${site.accent}}`}></style>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {site.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>}
  {site.cfAnalyticsToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}></script>}
  <slot name="head" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={localePath(locale, '/')}>{site.name}</a>
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={current === n.href.replace(/\/$/, '') || (n.href !== localePath(locale, '/') && current.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      {localized && site.locales.length > 1 && (
        <label class="lang">
          <span class="sr" style="position:absolute;left:-9999px">{strings.language}</span>
          <select onchange="location.href=this.value" aria-label={strings.language}>
            {site.locales.map((l) => <option value={localePath(l, path)} selected={l.prefix === locale.prefix}>{l.label}</option>)}
          </select>
        </label>
      )}
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      {strings.updated && <p>{strings.updated}</p>}
      <p>{strings.disclaimer}</p>
      <p><a href="/about">{strings.about}</a> · <a href="/privacy">{strings.privacy}</a></p>
    </div>
  </footer>
</body>
</html>
