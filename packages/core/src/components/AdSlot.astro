---
import type { SiteConfig } from '../lib/types';
interface Props { site: SiteConfig; slot?: string }
const { site, slot } = Astro.props;
---
{site.adsenseClient && slot ? (
  <div class="ad"><ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={site.adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script></div>
) : (
  <div class="ad ad-placeholder" aria-hidden="true">ad</div>
)}
