---
import { Image } from 'astro:assets';
import type { Hero } from '../lib/data';
interface Props { hero: Hero; size?: number; href?: string; label?: boolean }
const { hero, size = 36, href, label = true } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag href={href} class="hero-chip" style={`--c:${hero.color}`}>
  <Image src={hero.image} alt={hero.name} width={size} height={Math.round(size * 1.35)} loading="lazy" class="hero-img" />
  {label && <span>{hero.name}</span>}
</Tag>
<style>
  .hero-chip { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-weight: 600; }
  .hero-img { border-radius: 6px; object-fit: cover; background: color-mix(in srgb, var(--c) 35%, transparent); }
</style>
