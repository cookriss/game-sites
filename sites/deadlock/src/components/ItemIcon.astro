---
import { Image } from 'astro:assets';
import type { Item } from '../lib/data';
interface Props { item: Item; size?: number; label?: boolean }
const { item, size = 32, label = true } = Astro.props;
---
<span class={`item-chip slot-${item.slot}`} title={item.name}>
  <span class="item-box"><Image src={item.image} alt={item.name} width={size} height={size} loading="lazy" /></span>
  {label && <span>{item.name}</span>}
</span>
<style>
  .item-chip { display: inline-flex; align-items: center; gap: 8px; }
  .item-box { display: inline-grid; place-items: center; padding: 3px; border-radius: 6px; line-height: 0; }
  .slot-weapon .item-box { background: #c9772b; }
  .slot-vitality .item-box { background: #5a9a3a; }
  .slot-spirit .item-box { background: #8a5ac2; }
</style>
