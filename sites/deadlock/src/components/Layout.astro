---
import BaseLayout from '@gamesites/core/layouts/BaseLayout.astro';
import AdSlot from '@gamesites/core/components/AdSlot.astro';
import '../styles/site.css';
import type { Ctx } from '../lib/site';
interface Props { c: Ctx; path: string; title: string; description: string; jsonLd?: object | object[]; ogImage?: string; alternateLocales?: import('@gamesites/core/lib/types').Locale[]; ad?: boolean }
const { c, path, title, description, jsonLd, ogImage, alternateLocales, ad = true } = Astro.props;
---
<BaseLayout site={c.site} locale={c.locale} path={path} title={title} description={description} nav={c.nav} strings={c.strings} jsonLd={jsonLd} ogImage={ogImage} alternateLocales={alternateLocales}>
  <slot />
  {ad && <AdSlot site={c.site} />}
</BaseLayout>
