---
import BaseLayout from '@gamesites/core/layouts/BaseLayout.astro';
import AdSlot from '@gamesites/core/components/AdSlot.astro';
import type { Ctx } from '../lib/site';
interface Props { c: Ctx; path: string; title: string; description: string; jsonLd?: object | object[]; ogImage?: string }
const { c, path, title, description, jsonLd, ogImage } = Astro.props;
---
<BaseLayout site={c.site} locale={c.locale} path={path} title={title} description={description} nav={c.nav} strings={c.strings} jsonLd={jsonLd} ogImage={ogImage}>
  <slot />
  <AdSlot site={c.site} />
</BaseLayout>
