---
import type { Ctx } from '../lib/site';
import { getRanks, img } from '../lib/site';
interface Props { c: Ctx }
const { c } = Astro.props;
const ranks = (await getRanks(c.locale)).filter((r) => r.tier >= 1);
const opts = await Promise.all(ranks.map(async (r) => ({ value: r.tier * 10 + 1, label: c.t('rank_plus', { rank: r.name }), img: await img(r.image, 52) })));
---
<label class="rank-filter" data-rank-filter>
  <img src={opts[0]?.img} alt="" data-rank-img hidden />
  <span class="muted small">{c.t('rank_label')}</span>
  <select aria-label={c.t('rank_label')}>
    <option value="0" data-img="">{c.t('rank_all')}</option>
    {opts.map((o) => <option value={o.value} data-img={o.img}>{o.label}</option>)}
  </select>
</label>
<script>
  // Emits `rankchange` ({ minBadge }) on document. Remembers the choice in the URL and this browser.
  const root = document.querySelector<HTMLElement>('[data-rank-filter]');
  const sel = root?.querySelector('select');
  const icon = root?.querySelector<HTMLImageElement>('[data-rank-img]');
  const KEY = 'rankFilter';
  function apply(v: string, emit: boolean) {
    if (!sel || !icon) return;
    if (![...sel.options].some((o) => o.value === v)) v = '0';
    sel.value = v;
    const im = sel.selectedOptions[0]?.dataset.img;
    icon.hidden = !im; if (im) icon.src = im;
    const url = new URL(location.href);
    if (v === '0') url.searchParams.delete('rank'); else url.searchParams.set('rank', v);
    history.replaceState(null, '', url);
    try { localStorage.setItem(KEY, v); } catch {}
    if (emit) document.dispatchEvent(new CustomEvent('rankchange', { detail: { minBadge: Number(v) || undefined } }));
  }
  if (sel) {
    sel.addEventListener('change', () => apply(sel.value, true));
    let start = new URL(location.href).searchParams.get('rank');
    if (start === null) { try { start = localStorage.getItem(KEY); } catch {} }
    // Wait until every module script has run, so page listeners are registered.
    if (start && start !== '0') {
      const go = () => apply(start!, true);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go, { once: true });
      else window.addEventListener('load', go, { once: true });
    }
  }
</script>
