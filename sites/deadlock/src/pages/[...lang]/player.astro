---
import Layout from '../../components/Layout.astro';
import { langParams } from '@gamesites/core/lib/i18n';
import { ctx, SITE, getRanks, img } from '../../lib/site';
import type { PlayerPageData } from '../../lib/players';
export function getStaticPaths() { return langParams(SITE); }
const c = await ctx(Astro.params.lang);
const { t, L } = c;
const ranks = await getRanks(c.locale);
const pd: PlayerPageData = { ...(await c.pageData()), ranks: Object.fromEntries(await Promise.all(ranks.map(async (r) => [r.tier, { name: r.name, color: r.color, img: await img(r.image, 72) }]))) };
---
<Layout c={c} path="/player" title={`${t('player_title')} | ${SITE.name}`} description={t('player_desc')} noindex>
  <p class="small"><a href={L('/players')}>← {t('players_h1')}</a></p>
  <div class="player-head" data-head>
    <h1 data-name>{t('player_title')}</h1>
  </div>
  <div data-summary aria-live="polite"><p class="muted">{t('loading')}</p></div>
  <h2>{t('recent_matches')}</h2><div data-matches></div>
  <h2>{t('most_played')}</h2><div data-heroes></div>
  <script type="application/json" id="page-data" set:html={JSON.stringify(pd)} />
  <script>
    import { players, rankBadge, summaryCards, heroesTable, matchesTable, type PlayerPageData } from '../../lib/players';
    const d: PlayerPageData = JSON.parse(document.getElementById('page-data')!.textContent!);
    const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
    const id = Number(new URLSearchParams(location.search).get('id'));
    async function load() {
      if (!id) { $('[data-summary]').innerHTML = `<p class="muted">${d.s.player_noid}</p>`; return; }
      const [steam, rank, matches, heroes] = await Promise.all([
        players.steam(id).catch(() => null), players.rank(id), players.matches(id).catch(() => []), players.heroes(id).catch(() => []),
      ]);
      if (!steam && !matches.length) { $('[data-summary]').innerHTML = `<p class="muted">${d.s.player_not_found}</p>`; return; }
      const name = steam?.name ?? `#${id}`;
      document.title = `${name} · ${document.title}`;
      $('[data-head]').innerHTML = `${steam?.avatar ? `<img src="${esc(steam.avatar)}" alt="" width="64" height="64" class="avatar">` : ''}<div><h1>${esc(name)}</h1><div class="player-meta">${rankBadge(rank, d)}${steam ? ` · <a href="${esc(steam.profileUrl)}" rel="nofollow noopener" target="_blank">${d.s.steam_profile}</a>` : ''}</div></div>`;
      $('[data-summary]').innerHTML = summaryCards(matches, d);
      $('[data-heroes]').innerHTML = heroesTable(heroes, d);
      $('[data-matches]').innerHTML = matchesTable(matches, d);
    }
    load();
  </script>
</Layout>
