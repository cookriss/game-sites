---
import Layout from '../../components/Layout.astro';
import ItemIcon from '../../components/ItemIcon.astro';
import { langParams } from '@gamesites/core/lib/i18n';
import { ctx, getItems, getItemStats, WINDOW_DAYS, SITE } from '../../lib/site';
export function getStaticPaths() { return langParams(SITE); }
const c = await ctx(Astro.params.lang);
const { t, L } = c;
const stats = new Map((await getItemStats('all')).map((s) => [s.itemId, s]));
const items = (await getItems(c.locale)).filter((i) => stats.has(i.id));
const slots = (['weapon', 'vitality', 'spirit'] as const).map((slot) => ({
  slot, label: t(`slot_${slot}`),
  items: items.filter((i) => i.slot === slot).sort((a, b) => a.tier - b.tier || stats.get(b.id)!.winRate - stats.get(a.id)!.winRate),
}));
---
<Layout c={c} path="/items" title={t('items_title')} description={t('items_desc')}>
  <h1>{t('items_h1')}</h1>
  <p class="lede">{t('items_lede', { days: WINDOW_DAYS })}</p>
  {slots.map((s) => (
    <>
      <h2 id={s.slot}>{s.label}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>{t('col_item')}</th><th>{t('col_level')}</th><th>{t('col_cost')}</th><th>{t('col_wr')}</th><th>{t('col_matches')}</th></tr></thead>
          <tbody>{s.items.map((i) => { const st = stats.get(i.id)!; return (
            <tr><td><ItemIcon item={i} size={26} href={L(`/items/${i.slug}`)} /></td><td>{i.tier}</td><td>{c.nf(i.cost)}</td><td class={st.winRate >= .5 ? 'good' : 'bad'}>{c.pct(st.winRate)}</td><td>{c.compact(st.matches)}</td></tr>
          ); })}</tbody>
        </table>
      </div>
    </>
  ))}
  <p class="small muted">{t('sample_note')}</p>
</Layout>
