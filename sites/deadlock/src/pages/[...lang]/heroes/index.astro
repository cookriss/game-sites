---
import Layout from '../../../components/Layout.astro';
import HeroIcon from '../../../components/HeroIcon.astro';
import { langParams } from '@gamesites/core/lib/i18n';
import { ctx, heroRowsWithHero, SITE } from '../../../lib/site';
export function getStaticPaths() { return langParams(SITE); }
const c = await ctx(Astro.params.lang);
const { t, L } = c;
const rows = (await heroRowsWithHero(c.locale, 'all')).sort((a, b) => a.hero.name.localeCompare(b.hero.name, c.locale.lang));
---
<Layout c={c} path="/heroes" title={t('heroes_title')} description={t('heroes_desc')}>
  <h1>{t('heroes_h1')}</h1>
  <p class="lede">{t('heroes_desc')}</p>
  <div class="heroes">
    {rows.map((r) => (
      <a class="card hcell" href={L(`/heroes/${r.hero.slug}`)}>
        <HeroIcon hero={r.hero} size={72} label={false} />
        <strong>{r.hero.name}</strong>
        <span class="small"><span class={`tier tier-${r.tier}`} style="width:20px;height:20px;font-size:.75rem">{r.tier}</span> <span class={r.winRate >= .5 ? 'good' : 'bad'}>{c.pct(r.winRate)}</span></span>
      </a>
    ))}
  </div>
</Layout>
<style>
  .heroes { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
  .hcell { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; color: var(--text); padding: 12px 8px; }
  .hcell:hover { text-decoration: none; border-color: var(--accent); }
</style>
