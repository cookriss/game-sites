---
import Layout from '../../components/Layout.astro';
import RankFilter from '../../components/RankFilter.astro';
import { langParams } from '@gamesites/core/lib/i18n';
import { ctx, heroRows, WINDOW_DAYS, SITE } from '../../lib/site';
import { tierTbody } from '../../lib/render';
export function getStaticPaths() { return langParams(SITE); }
const c = await ctx(Astro.params.lang);
const { t, L } = c;
const rows = await heroRows(c.locale, 'all');
const pd = await c.pageData();
const title = t('tier_title', { month: c.month });
const description = t('tier_desc', { month: c.month, count: c.compact(c.matches) });
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: title,
  itemListElement: rows.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: pd.heroes[r.heroId]?.name, url: SITE.url + L(`/heroes/${pd.heroes[r.heroId]?.slug}`) })),
};
const cols: [string, string, string?][] = [
  ['rank', '#'], ['name', t('col_hero')], ['rank', t('col_tier')], ['winRate', t('col_wr')], ['winRate', 'Δ'], ['pickRate', t('col_pr')],
  ['banRate', t('col_br'), 'hide-sm'], ['kda', t('col_kda'), 'hide-sm'], ['netWorth', t('st_networth'), 'hide-sm'], ['matches', t('col_matches'), 'hide-sm'],
];
---
<Layout c={c} path="/tier-list" title={title} description={description} jsonLd={jsonLd}>
  <h1>{t('tier_h1')} <span class="muted" style="font-weight:400">· {c.month}</span></h1>
  <p class="lede">{t('tier_lede', { days: WINDOW_DAYS })} {t('sort_hint')}</p>
  <div class="filters"><RankFilter c={c} /><span class="muted small" data-count>{c.compact(rows.reduce((s, r) => s + r.matches, 0) / 12)} {t('col_matches').toLowerCase()}</span></div>
  <div class="table-wrap" data-live>
    <table class="sortable" data-tier-table>
      <thead><tr>{cols.map(([k, label, cl], i) => <th class={cl} data-k={k} aria-sort={i === 0 ? 'descending' : undefined}>{label}</th>)}</tr></thead>
      <tbody set:html={tierTbody(rows, pd, c.f)} />
    </table>
  </div>
  <script type="application/json" id="page-data" set:html={JSON.stringify(pd)} />
  <script type="application/json" id="rows-data" set:html={JSON.stringify(rows)} />
  <script>
    import { live } from '../../lib/data/live';
    import { tierRows, tierTbody, sortTierRows, makeFmt, type PageData, type TierRow, type TierSortKey } from '../../lib/render';
    const d: PageData = JSON.parse(document.getElementById('page-data')!.textContent!);
    const f = makeFmt(d.lang);
    const known = new Set(Object.keys(d.heroes).map(Number));
    let rows: TierRow[] = JSON.parse(document.getElementById('rows-data')!.textContent!);
    let key: TierSortKey = 'rank'; let dir: 1 | -1 = 1;
    const table = document.querySelector<HTMLTableElement>('[data-tier-table]')!;
    const wrap = table.closest<HTMLElement>('[data-live]')!;
    const count = document.querySelector('[data-count]');
    const draw = () => { table.tBodies[0].innerHTML = tierTbody(sortTierRows(rows, key, dir, d), d, f); };
    table.tHead!.addEventListener('click', (e) => {
      const th = (e.target as HTMLElement).closest('th'); if (!th) return;
      const k = th.dataset.k as TierSortKey;
      if (k === key) dir = dir === 1 ? -1 : 1; else { key = k; dir = k === 'name' ? -1 : 1; }
      table.tHead!.querySelectorAll('th').forEach((x) => x.removeAttribute('aria-sort'));
      th.setAttribute('aria-sort', dir === 1 ? 'descending' : 'ascending');
      draw();
    });
    document.addEventListener('rankchange', async (e) => {
      const q = { minBadge: (e as CustomEvent).detail.minBadge };
      wrap.classList.add('loading');
      try {
        const [stats, bans] = await Promise.all([live.heroStats(q), live.banStats(q).catch(() => [])]);
        rows = tierRows(stats, bans, known);
        if (count) count.textContent = `${f.compact(rows.reduce((s, r) => s + r.matches, 0) / 12)} ${d.s.col_matches.toLowerCase()}`;
        draw();
      } catch { table.tBodies[0].innerHTML = `<tr><td colspan="10" class="muted">${d.s.no_data}</td></tr>`; }
      wrap.classList.remove('loading');
    });
  </script>
</Layout>
