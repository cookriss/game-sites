---
import BaseLayout from '@gamesites/core/layouts/BaseLayout.astro';
import { ctx } from '../lib/site';
const c = await ctx(undefined);
---
<BaseLayout site={c.site} locale={c.locale} path="/privacy" title={`Privacy Policy | ${c.site.name}`} description={`Privacy policy for ${c.site.name}.`} nav={c.nav} strings={c.strings} localized={false}>
  <h1>Privacy Policy</h1>
  <p>{c.site.name} has no accounts and does not ask for personal data.</p>
  <h2>Advertising</h2>
  <p>This site may show ads served by Google AdSense. Google and its partners use cookies to serve ads based on your visits to this and other websites. You can opt out of personalised advertising at <a href="https://adssettings.google.com">Google Ads Settings</a>. Visitors in the EEA, the UK and Switzerland are asked for consent before personalised ads are shown.</p>
  <h2>Analytics</h2>
  <p>We may use Cloudflare Web Analytics, which counts page views without cookies and without tracking individual visitors.</p>
  <h2>Contact</h2>
  <p>Questions about this policy can be sent through the contact details on the About page.</p>
</BaseLayout>
