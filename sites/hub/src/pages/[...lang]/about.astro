---
import Layout from '../../components/Layout.astro';
import { langParams } from '@gamesites/core/lib/i18n';
import { ctx, SITE } from '../../lib/site';
export function getStaticPaths() { return langParams(SITE); }
const c = ctx(Astro.params.lang);
const { t } = c;
---
<Layout c={c} path="/about" title={`${t('about_title')} | ${SITE.name}`} description={t('about_desc')} ad={false}>
  <h1>{t('about_title')}</h1>
  <p>{t('about_p1')}</p>
  <p>{t('about_p2')}</p>
  <p class="muted">{t('disclaimer')}</p>
</Layout>
