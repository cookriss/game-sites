---
import Layout from '../../components/Layout.astro';
import LegalContent from '@gamesites/core/legal/LegalContent.astro';
import { legalPaths, legalLocales, legalDoc, legalLang, type LegalDocId } from '@gamesites/core/legal/index';
import { ctx, SITE } from '../../lib/site';
export function getStaticPaths() { return legalPaths(SITE); }
const c = await ctx(Astro.params.lang);
const doc = Astro.params.doc as LegalDocId;
const lang = legalLang(c.locale.lang);
const d = legalDoc(doc, lang, SITE);
---
<Layout c={c} path={'/' + doc} title={`${d.title} | ${SITE.name}`} description={d.description} alternateLocales={legalLocales(SITE)} ad={false}>
  <LegalContent site={SITE} doc={doc} lang={lang} />
</Layout>
