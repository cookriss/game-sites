---
/** Searchable, filterable, sortable table; or a "coming soon" state when the table has no rows yet. */
import type { DbTable, Cell } from '../content/petit-planet-db';
import type { Lang } from '../content/types';
import { icon } from '../content/pp/art';
interface Props { table: DbTable; lang: Lang; release?: string; backHref: string }
const { table, lang, release, backHref } = Astro.props;
const S = {
  en: { search: 'Search', all: 'All', results: 'results', soon: 'Coming on launch day', soonP: 'This database will be filled from the live game as soon as Petit Planet launches. Here is what it will include:', back: 'All databases', none: 'No matches' },
  es: { search: 'Buscar', all: 'Todos', results: 'resultados', soon: 'Disponible el día del lanzamiento', soonP: 'Rellenaremos esta base de datos con el juego real en cuanto salga Petit Planet. Esto es lo que incluirá:', back: 'Todas las bases de datos', none: 'Sin resultados' },
  pt: { search: 'Buscar', all: 'Todos', results: 'resultados', soon: 'Disponível no dia do lançamento', soonP: 'Vamos preencher este banco de dados com o jogo real assim que Petit Planet for lançado. Isto é o que ele vai incluir:', back: 'Todos os bancos de dados', none: 'Nenhum resultado' },
}[lang];
const text = (v: Cell | undefined) => (v === undefined ? '' : typeof v === 'object' ? v[lang] : String(v));
const empty = table.rows.length === 0;
const filters = table.columns.filter((c) => c.filter).map((c) => ({ c, values: [...new Set(table.rows.map((r) => text(r[c.key])).filter(Boolean))].sort() }));
const fmtRelease = release ? new Intl.DateTimeFormat({ en: 'en-GB', es: 'es-ES', pt: 'pt-BR' }[lang], { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(release + 'T00:00:00Z')) : '';
---
{empty ? (
  <div class="db-soon">
    <Fragment set:html={icon(table.id, 64)} />
    <div>
      <span class="soon-badge">{S.soon}{fmtRelease && ` · ${fmtRelease}`}</span>
      <p>{S.soonP}</p>
      <ul class="cols">{table.columns.map((c) => <li>{c.label[lang]}</li>)}</ul>
    </div>
  </div>
  <div class="table-wrap db-skeleton" aria-hidden="true">
    <table><thead><tr>{table.columns.map((c) => <th>{c.label[lang]}</th>)}</tr></thead>
    <tbody>{[0, 1, 2, 3, 4].map(() => <tr>{table.columns.map(() => <td><span class="sk" /></td>)}</tr>)}</tbody></table>
  </div>
) : (
  <div class="db" data-db>
    <div class="db-tools">
      <input type="search" placeholder={S.search} aria-label={S.search} data-q />
      {filters.map(({ c, values }) => (
        <select data-f={c.key} aria-label={c.label[lang]}>
          <option value="">{c.label[lang]}: {S.all}</option>
          {values.map((v) => <option value={v}>{v}</option>)}
        </select>
      ))}
      <span class="muted small"><b data-count>{table.rows.length}</b> {S.results}</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>{table.columns.map((c, i) => <th class:list={{ num: c.num }}><button type="button" data-sort={i}>{c.label[lang]}</button></th>)}</tr></thead>
        <tbody>
          {table.rows.map((r) => (
            <tr {...Object.fromEntries(table.columns.filter((c) => c.filter).map((c) => [`data-${c.key}`, text(r[c.key])]))}>
              {table.columns.map((c, i) => <td class:list={{ num: c.num }} data-v={text(r[c.key])}>{i === 0 ? <b>{text(r[c.key])}</b> : text(r[c.key])}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted small" data-none hidden>{S.none}</p>
  </div>
)}
<p class="small"><a href={backHref}>← {S.back}</a></p>
<script>
  for (const db of document.querySelectorAll<HTMLElement>('[data-db]')) {
    const q = db.querySelector<HTMLInputElement>('[data-q]')!;
    const sels = [...db.querySelectorAll<HTMLSelectElement>('[data-f]')];
    const body = db.querySelector('tbody')!;
    const rows = [...body.querySelectorAll('tr')];
    const count = db.querySelector('[data-count]')!;
    const none = db.querySelector<HTMLElement>('[data-none]')!;
    const apply = () => {
      const term = q.value.trim().toLowerCase();
      let n = 0;
      for (const r of rows) {
        const ok = (!term || r.textContent!.toLowerCase().includes(term)) && sels.every((s) => !s.value || r.dataset[s.dataset.f!] === s.value);
        r.hidden = !ok; if (ok) n++;
      }
      count.textContent = String(n); none.hidden = n > 0;
    };
    q.addEventListener('input', apply); sels.forEach((s) => s.addEventListener('change', apply));
    let dir = 1, last = -1;
    db.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.dataset.sort); dir = i === last ? -dir : 1; last = i;
      const v = (r: Element) => (r.children[i] as HTMLElement).dataset.v ?? '';
      rows.sort((a, c) => { const x = v(a), y = v(c), nx = parseFloat(x), ny = parseFloat(y); return (isNaN(nx) || isNaN(ny) ? x.localeCompare(y) : nx - ny) * dir; });
      rows.forEach((r) => body.appendChild(r));
    }));
  }
</script>
<style>
  .db-soon { display: flex; gap: 18px; align-items: flex-start; padding: 18px 20px; border-radius: 20px; background: var(--panel); border: 1px dashed color-mix(in srgb, var(--g) 60%, var(--line)); margin: 8px 0 14px; }
  .db-soon :global(.cat-icon) { flex: none; }
  .db-soon p { margin: 8px 0; }
  .soon-badge { display: inline-block; padding: 3px 12px; border-radius: 999px; background: var(--g); color: #fff; font-weight: 800; font-size: .85rem; }
  .cols { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 6px 0 0; list-style: none; }
  .cols li { padding: 2px 10px; border-radius: 999px; background: color-mix(in srgb, var(--g) 14%, var(--panel)); font-size: .85rem; font-weight: 600; }
  .db-skeleton { opacity: .7; }
  .db-skeleton th, .db-tools ~ .table-wrap th { text-align: left; }
  .sk { display: block; height: 10px; border-radius: 6px; width: 70%; background: linear-gradient(90deg, var(--line), color-mix(in srgb, var(--line) 40%, transparent), var(--line)); background-size: 200% 100%; animation: sk 1.6s infinite linear; }
  @keyframes sk { to { background-position: -200% 0; } }
  .db-tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 8px 0 10px; }
  .db-tools input, .db-tools select { padding: 8px 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--panel); color: var(--text); font: inherit; }
  .db-tools input { flex: 1 1 200px; }
  .db td, .db th { text-align: left; white-space: normal; }
  .db .num { text-align: right; }
  .db th button { all: unset; cursor: pointer; }
  .db th button::after { content: " ↕"; opacity: .4; }
  @media (max-width: 560px) { .db-soon { flex-direction: column; gap: 8px; } }
</style>
