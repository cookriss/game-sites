---
import BaseLayout from '@gamesites/core/layouts/BaseLayout.astro';
import AdSlot from '@gamesites/core/components/AdSlot.astro';
import type { Locale } from '@gamesites/core/lib/types';
import type { Ctx } from '../lib/site';
interface Props { c: Ctx; path: string; title: string; description: string; jsonLd?: object | object[]; ogImage?: string; alternateLocales?: Locale[]; ad?: boolean; noindex?: boolean; localized?: boolean }
const { c, path, title, description, jsonLd, ogImage, alternateLocales, ad = true, noindex = false, localized = true } = Astro.props;
---
<BaseLayout site={c.site} locale={c.locale} path={path} title={title} description={description} nav={c.nav} strings={c.strings} jsonLd={jsonLd} ogImage={ogImage} alternateLocales={alternateLocales} noindex={noindex} localized={localized}>
  <slot name="head" slot="head" />
  <slot />
  {ad && <AdSlot site={c.site} />}
</BaseLayout>
