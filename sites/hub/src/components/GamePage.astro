---
import Layout from './Layout.astro';
import type { GamePageContent } from '../content/types';
import { BUILD_DATE, type Ctx } from '../lib/site';
import { GAMES } from '../games';
import PetitPlanetTheme from '../themes/PetitPlanetTheme.astro';
import AnantaTheme from '../themes/AnantaTheme.astro';
import { SECTION_NAV } from '../content/nav';
import { icon } from '../content/pp/art';
interface Props { c: Ctx; page: GamePageContent }
const { c, page } = Astro.props;
const { lang, L, t } = c;
const S = {
  en: { home: 'Home', updated: 'Updated', facts: 'Key facts', faq: 'Frequently asked questions', sources: 'Sources', launch: 'Launch' },
  es: { home: 'Inicio', updated: 'Actualizado', facts: 'Datos clave', faq: 'Preguntas frecuentes', sources: 'Fuentes', launch: 'Lanzamiento' },
  pt: { home: 'Início', updated: 'Atualizado', facts: 'Dados principais', faq: 'Perguntas frequentes', sources: 'Fontes', launch: 'Lançamento' },
}[lang];
const pp = page.slug === 'petit-planet';
const an = page.slug === 'ananta';
const game = GAMES.find((g) => g.slug === page.slug);
const fmt = (iso: string) => new Intl.DateTimeFormat(c.locale.lang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso + 'T00:00:00Z'));
const days = page.release ? Math.ceil((Date.parse(page.release + 'T00:00:00Z') - BUILD_DATE.getTime()) / 86400000) : undefined;
const path = page.path ?? '/' + page.slug;
const isSub = path !== '/' + page.slug;
const url = c.site.url + L(path);
const faq = page.faq ?? [];
const facts = page.facts ?? [];
const subnav = SECTION_NAV[page.slug] ?? [];
const explore = subnav.filter((n) => n.blurb);
/** Content HTML writes internal links as {L}/path so they get the locale prefix. */
const fill = (h: string) => h.replace(/\{L\}(\/[^"]*)/g, (_m, p: string) => L(p));
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: S.home, item: c.site.url + L('/') },
    { '@type': 'ListItem', position: 2, name: page.name, item: c.site.url + L('/' + page.slug) },
    ...(page.parent ? [{ '@type': 'ListItem', position: 3, name: page.parent.label[lang], item: c.site.url + L(page.parent.path) }] : []),
    ...(isSub ? [{ '@type': 'ListItem', position: page.parent ? 4 : 3, name: page.crumb?.[lang] ?? page.h1[lang], item: url }] : []),
  ] },
  !isSub && { '@context': 'https://schema.org', '@type': 'VideoGame', name: page.name, url, datePublished: page.release, publisher: game ? { '@type': 'Organization', name: game.publisher } : undefined, gamePlatform: game?.platforms },
  faq.length > 0 && { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })) },
  { '@context': 'https://schema.org', '@type': 'Article', headline: page.h1[lang], dateModified: page.updated, inLanguage: c.locale.lang, mainEntityOfPage: url },
].filter(Boolean) as object[];
---
<Layout c={c} section={{ brand: { label: page.name, href: L('/' + page.slug) }, nav: subnav.map((n) => ({ href: L(n.path), label: n.label[lang] })) }} path={path} title={page.title[lang]} description={page.description[lang]} jsonLd={jsonLd} noindex={page.noindex}>
  {pp && <PetitPlanetTheme slot="head" />}
  {an && <AnantaTheme slot="head" />}
  {pp && <svg slot="brand-icon" class="brand-icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="18" r="10" fill="#9fd8b8" /><ellipse cx="16" cy="18" rx="15" ry="3.5" fill="none" stroke="#ffc6d6" stroke-width="2" transform="rotate(-12 16 18)" /><path d="M16 8V4" stroke="#7a5c3e" stroke-width="2" stroke-linecap="round" /><path d="M16 5c-3-3-6-1-6 1 3 1 5 0 6-1zM16 5c2-3 6-2 6 0-3 1-5 1-6 0z" fill="#8fd17a" /></svg>}
  {an && <svg slot="brand-icon" class="brand-icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 28V14h5v14M11 28V6h6v22M19 28V11h5v17M26 28V17h3v11" fill="none" stroke="#ff4fa3" stroke-width="2.2" stroke-linejoin="round" /><path d="M2 28h28" stroke="#3fe3ff" stroke-width="2.2" stroke-linecap="round" /></svg>}
  {isSub && <nav class="crumbs small muted"><a href={L('/' + page.slug)}>{page.name}</a>{page.parent && <> › <a href={L(page.parent.path)}>{page.parent.label[lang]}</a></>} › {page.crumb?.[lang]}</nav>}
  <article class:list={["gp", { "theme-pp": pp, "theme-an": an }]} style={`--g:${pp ? '#ff8fab' : an ? '#ff4fa3' : game?.color ?? 'var(--accent)'}`}>
<header class:list={["hero", { "hero-main": !isSub }]}>
<div class="hero-text">
    <h1>{page.h1[lang]}</h1>
    <p class="lede">{page.lede[lang]}</p>
    <p class="muted small">{S.updated}: <time datetime={page.updated}>{fmt(page.updated)}</time></p>
    {!isSub && page.release && days !== undefined && (
      <div class="countdown">
        <span class="muted small">{S.launch}</span>
        <b>{fmt(page.release)}</b>
        <span>{days > 0 ? t('days_left', { n: days }) : t('released')}</span>
      </div>
    )}
</div>
    {pp && !isSub && (
      <svg class="pp-art" viewBox="0 0 120 120" aria-hidden="true">
        <circle cx="60" cy="72" r="38" fill="#9fd8b8" /><path d="M24 80a38 38 0 0 0 72 0c-12 8-60 8-72 0z" fill="#7cc4a0" />
        <circle cx="46" cy="64" r="5" fill="#fff" opacity=".5" /><ellipse cx="60" cy="72" rx="56" ry="10" fill="none" stroke="#ffc6d6" stroke-width="4" transform="rotate(-12 60 72)" />
        <path d="M60 34v-14" stroke="#7a5c3e" stroke-width="4" stroke-linecap="round" /><path d="M60 22c-10-10-22-4-22 4 10 2 18 0 22-4zM60 20c8-12 22-8 22 0-10 3-18 2-22 0z" fill="#8fd17a" />
        <path d="M100 18l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" fill="#ffd27a" /><path d="M16 30l1.5 4 4 1.5-4 1.5-1.5 4-1.5-4-4-1.5 4-1.5z" fill="#fff" />
      </svg>
    )}
</header>
    {!isSub && explore.length > 0 && (
      <nav class="explore" aria-label={page.name}>
        {explore.map((n) => <a class="explore-card" href={L(n.path)}><Fragment set:html={icon(n.icon ?? '', 44)} /><span><b>{n.label[lang]}</b><small>{n.blurb![lang]}</small></span></a>)}
      </nav>
    )}
    {facts.length > 0 && <h2>{S.facts}</h2>}
    {facts.length > 0 && <div class="table-wrap"><table class="facts"><tbody>
      {facts.map((f) => <tr><th>{f.label[lang]}</th><td>{f.value[lang]}</td></tr>)}
    </tbody></table></div>}
    {page.sections.map((s) => (<section id={s.id}><h2>{s.h[lang]}</h2><Fragment set:html={fill(s.html[lang])} /></section>))}
    <slot />
    {faq.length > 0 && <h2 id="faq">{S.faq}</h2>}
    {faq.map((f) => (<details class="faq"><summary>{f.q[lang]}</summary><p>{f.a[lang]}</p></details>))}
    {page.sources.length > 0 && <h2 id="sources">{S.sources}</h2>}
    {page.sources.length > 0 && <ul class="sources small">{page.sources.map((s) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.label}</a></li>)}</ul>}
  </article>
</Layout>
<style>
  .hero { display: flex; gap: 16px; align-items: flex-start; }
  .hero-text { flex: 1; min-width: 0; }
  .hero-main { padding: 22px 22px 12px; margin: 4px 0 18px; border-radius: 24px; background: linear-gradient(135deg, color-mix(in srgb, var(--g) 16%, var(--panel)), var(--panel)); border: 1px solid var(--line); }
  .pp-art { width: 120px; height: 120px; flex: none; }
  .explore { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin: 0 0 8px; }
  .explore-card { display: flex; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 16px; background: var(--panel); border: 1px solid var(--line); color: var(--text); transition: transform .15s, box-shadow .15s; }
  .explore-card:hover { text-decoration: none; transform: translateY(-2px); box-shadow: 0 6px 18px color-mix(in srgb, var(--g) 25%, transparent); }
  .explore-card b { display: block; color: var(--g); }
  .explore-card small { display: block; color: var(--muted); font-size: .82rem; line-height: 1.35; }
  .explore-card :global(.cat-icon) { flex: none; }
  .hero-main { position: relative; }
  @media (max-width: 560px) { .hero-main .pp-art { position: absolute; top: 10px; right: 10px; width: 52px; height: 52px; } .hero-main h1 { padding-right: 44px; } .hero-main { padding: 16px 14px 8px; } }
  .brand-icon { width: 26px; height: 26px; vertical-align: -7px; margin-right: 7px; }
  .gp :global(.cards) { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); margin: 10px 0; }
  .gp :global(.ncard) { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; }
  .gp :global(.nhead) { display: flex; gap: 12px; align-items: center; }
  .gp :global(.avatar) { width: 64px; height: 64px; flex: none; border-radius: 50%; box-shadow: 0 3px 10px #8f86c933; }
  .gp :global(.ncard h3) { margin: 0 0 2px; font-size: 1.05rem; }
  .gp :global(.ncard p) { margin: 4px 0 0; font-size: .9rem; }
  .gp :global(.ncard .role) { color: var(--g); font-weight: 700; font-size: .9rem; }
  .gp :global(.note) { font-size: .88rem; color: var(--muted); border-left: 3px solid var(--g); padding: 4px 10px; }
  .crumbs { margin: 8px 0 4px; }
  .crumbs a { color: inherit; }
  .gp h1 { border-left: 4px solid var(--g); padding-left: 12px; }
  .countdown { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; padding: 12px 16px; border-radius: 10px; border: 1px solid var(--g); margin: 12px 0 8px; }
  .countdown b { font-size: 1.15rem; }
  .facts th, .facts td { text-align: left; white-space: normal; vertical-align: top; }
  .facts th { width: 36%; }
  .facts td { color: var(--text, inherit); }
  .faq { border: 1px solid var(--border, rgba(127,127,127,.25)); border-radius: 8px; padding: 10px 14px; margin: 8px 0; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .sources li { margin: 4px 0; overflow-wrap: anywhere; }
</style>
